<Project>

  <!--
    Gestion centralisee des versions de paquets.
    Constitution v1.0.1 : « Les dependances MUST etre epinglees et auditees ».

    Chaque version est fixee ici et nulle part ailleurs : aucun projet ne doit porter
    d'attribut Version sur un PackageReference. Une montee de version est donc toujours
    un changement visible en revue, jamais un effet de bord d'une restauration.

    Toutes les versions ci-dessous ont ete confirmees par une restauration reussie le
    2026-09-18 sur le SDK 10.0.401. Serilog.Sinks.EventLog est en 4.0.0 : la 5.0.0
    n existe qu en preversion, et le projet n embarque aucune preversion.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Hebergement du service">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <!--
      SystemEvents porte la notification de sortie de veille, indispensable a FR-036 :
      au reveil, les handles d interception sont invalides et les regles doivent etre
      reappliquees. Le type vit dans ce paquet depuis .NET Core, plus dans le framework.
    -->
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Journalisation (principe VI)">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Interface">
    <!-- MVVM par generateur de source : ViewModels testables sans WPF. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      FluentAssertions reste volontairement en 7.x : a partir de la 8.0, le paquet est
      passe sous licence Xceed, payante pour tout usage commercial. La 7.x demeure sous
      Apache-2.0. Ne pas monter en version sans decision explicite sur la licence.
    -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!--
      Horloge virtuelle officielle du framework. Le principe III exige une horloge
      injectee et zero Thread.Sleep ; TimeProvider (BCL) plus FakeTimeProvider le
      fournissent sans qu on ait a ecrire et maintenir notre propre abstraction.
    -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

</Project>

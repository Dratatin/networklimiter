<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      Pour NotifyIcon seulement (zone de notification, T121). Livre avec le framework, donc
      aucune dependance externe : l alternative, piloter Shell_NotifyIcon a la main, exigerait
      une fenetre cachee, une procedure de fenetre et la gestion du redemarrage de l explorateur.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkLimiter.Core\NetworkLimiter.Core.csproj" />
    <ProjectReference Include="..\NetworkLimiter.Contracts\NetworkLimiter.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkLimiter.App.Tests" />
  </ItemGroup>

</Project>

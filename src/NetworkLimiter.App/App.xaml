<Application x:Class="NetworkLimiter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NetworkLimiter.App.ViewModels"
             xmlns:views="clr-namespace:NetworkLimiter.App.Views">
    <Application.Resources>

        <views:NotConverter x:Key="Not" />
        <views:RateUnitIndexConverter x:Key="RateUnitIndex" />
        <views:TextToVisibilityConverter x:Key="TextToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />

        <!--
            Gabarit de saisie d'un débit, partagé par les deux sens.
            L'unité est dans la liste déroulante, donc toujours à l'écran, et les bornes sont
            rappelées juste dessous : les deux exigences explicites de FR-007.
        -->
        <DataTemplate x:Key="RateInputTemplate" DataType="{x:Type vm:RateInputViewModel}">
            <StackPanel Margin="0,4,0,0">
                <CheckBox Content="Illimité" IsChecked="{Binding Unlimited}" />

                <Grid Margin="0,6,0,0" IsEnabled="{Binding Unlimited, Converter={StaticResource Not}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="6,4" />

                    <ComboBox Grid.Column="1"
                              Margin="8,0,0,0"
                              MinWidth="80"
                              SelectedIndex="{Binding Unit, Converter={StaticResource RateUnitIndex}}">
                        <ComboBoxItem Content="Ko/s" />
                        <ComboBoxItem Content="Mo/s" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="{Binding BoundsHint}"
                           Opacity="0.65"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

    </Application.Resources>
</Application>
